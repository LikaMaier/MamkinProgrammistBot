# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...

# Telegram ID администраторов через запятую (узнать свой — команда /id в боте)
ADMIN_IDS=123456789

# Публичный https-адрес сервиса (Railway → Settings → Networking → Generate Domain)
WEBAPP_URL=https://your-app.up.railway.app

# Путь к базе. На Railway подключите Volume с mount path /data
DB_PATH=/data/shop.db

SHOP_NAME=SoftSetup — установка ПО

# Оплата: off | stars | provider
PAYMENT_MODE=off
# Для provider: токен ЮKassa из @BotFather → Payments
PAYMENT_PROVIDER_TOKEN=
# Для stars: сколько рублей считать за 1 звезду
STAR_RATE_RUB=1.8

# За сколько часов до записи клиент может сам отменить/перенести
CANCEL_DEADLINE_HOURS=2

# Только для локальной отладки в браузере
DEV_MODE=0
